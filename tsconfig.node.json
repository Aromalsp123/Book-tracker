{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vite/client"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "docs/architecture/*.ts",
    "diagnostics/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "functions/**",
    "node_modules/**"
  ]
}
